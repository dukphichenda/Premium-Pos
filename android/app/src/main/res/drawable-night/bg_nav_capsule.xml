<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Less-transparent dark obsidian frosted glass base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#EA162033"
                android:endColor="#E80F172A"
                android:startColor="#F01E293B" />
            <stroke
                android:width="1dp"
                android:color="#7A64748B" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Subtle luminous inner glass rim -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
