<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Telegram Android dark floating frosted pill (#1C242F) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EC1C242F" />
            <stroke
                android:width="0.75dp"
                android:color="#26FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Subtle inner top/rim sheen -->
    <item
        android:bottom="0.75dp"
        android:left="0.75dp"
        android:right="0.75dp"
        android:top="0.75dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="0.75dp"
                android:color="#14FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
