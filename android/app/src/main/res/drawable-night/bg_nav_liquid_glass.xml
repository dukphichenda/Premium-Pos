<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle deep ocean-cyan (#0A6E80) glass glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#360A6E80" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Dark #0A6E80 liquid glass lens body -->
    <item
        android:bottom="1.5dp"
        android:left="1dp"
        android:right="1dp"
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#4A0A6E80"
                android:centerY="0.55"
                android:endColor="#560D8AA0"
                android:startColor="#44FFFFFF" />
            <stroke
                android:width="1.2dp"
                android:color="#66FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Upper crystal specular highlight -->
    <item
        android:bottom="26dp"
        android:left="6dp"
        android:right="6dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#55FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Bottom deep-cyan caustic reflection -->
    <item
        android:bottom="2.5dp"
        android:left="10dp"
        android:right="10dp"
        android:top="34dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#4C22B5CC"
                android:startColor="#0022B5CC" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
