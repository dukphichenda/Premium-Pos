<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle teal-glass glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#242DD4BF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Dark liquid glass lens body -->
    <item
        android:bottom="1.5dp"
        android:left="1dp"
        android:right="1dp"
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#302DD4BF"
                android:centerY="0.55"
                android:endColor="#4438BDF8"
                android:startColor="#48FFFFFF" />
            <stroke
                android:width="1.2dp"
                android:color="#66FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Upper crystal specular highlight -->
    <item
        android:bottom="26dp"
        android:left="6dp"
        android:right="6dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#55FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Bottom aqua caustic reflection -->
    <item
        android:bottom="2.5dp"
        android:left="10dp"
        android:right="10dp"
        android:top="34dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#482DD4BF"
                android:startColor="#002DD4BF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
