<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.InFlowPremium" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceContainerHigh">@color/glass_dialog_bg</item>
        <item name="colorSurfaceContainerHighest">@color/surface_subtle</item>
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.InFlow.LiquidGlassDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.InFlow.LiquidGlassDialog</item>
        <item name="popupMenuStyle">@style/Widget.InFlow.LiquidGlassPopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.InFlow.LiquidGlassPopupMenu</item>
    </style>

    <!-- Modern iOS-Inspired Liquid Glass Dialog Theme -->
    <style name="ThemeOverlay.InFlow.LiquidGlassDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/glass_dialog_bg</item>
        <item name="colorSurfaceContainerHigh">@color/glass_dialog_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.InFlow.LiquidGlassDialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.InFlow.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.InFlow.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.InFlow.DialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.InFlow.DialogNegativeButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.InFlow.DialogNeutralButton</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.28</item>
        <item name="android:windowBlurBehindEnabled" tools:targetApi="s">true</item>
        <item name="android:windowBlurBehindRadius" tools:targetApi="s">22dp</item>
        <item name="android:windowBackgroundBlurRadius" tools:targetApi="s">28dp</item>
    </style>

    <style name="ShapeAppearance.InFlow.LiquidGlassDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="TextAppearance.InFlow.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.InFlow.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.InFlow.DialogPositiveButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingHorizontal" tools:targetApi="o">18dp</item>
        <item name="android:layout_marginStart">6dp</item>
    </style>

    <style name="Widget.InFlow.DialogNegativeButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/glass_btn_bg</item>
        <item name="strokeColor">@color/glass_btn_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingHorizontal" tools:targetApi="o">16dp</item>
    </style>

    <style name="Widget.InFlow.DialogNeutralButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">999dp</item>
    </style>

    <style name="Widget.InFlow.LiquidGlassPopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_liquid_glass_popup</item>
        <item name="android:popupElevation">12dp</item>
    </style>
</resources>
