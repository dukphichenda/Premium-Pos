<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle outer refractive ambient shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#140F172A" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Translucent frosted liquid glass body -->
    <item
        android:bottom="1.5dp"
        android:left="1dp"
        android:right="1dp"
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#D8F8FAFC"
                android:centerY="0.48"
                android:endColor="#DFEEF6FF"
                android:startColor="#EBFFFFFF" />
            <stroke
                android:width="1.3dp"
                android:color="#F2FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Top glossy liquid-glass specular reflection -->
    <item
        android:bottom="80dp"
        android:left="10dp"
        android:right="10dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#B8FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
