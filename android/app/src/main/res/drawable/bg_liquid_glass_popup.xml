<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#DCF1F5F9"
                android:startColor="#EDFFFFFF" />
            <stroke
                android:width="1.1dp"
                android:color="#E8FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="0.8dp"
                android:color="#4094A3B8" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
