<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Telegram Android floating frosted white pill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EAFFFFFF" />
            <stroke
                android:width="0.75dp"
                android:color="#1E0F172A" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Delicate inner specular hairline -->
    <item
        android:bottom="0.75dp"
        android:left="0.75dp"
        android:right="0.75dp"
        android:top="0.75dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="0.75dp"
                android:color="#B8FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
