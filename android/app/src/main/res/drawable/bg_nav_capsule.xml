<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Less-transparent frosted glass base with soft outer rim -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#EAF8FAFC"
                android:endColor="#E4EDF4FA"
                android:startColor="#F2FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#94CBD5E1" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Crisp inner specular white glass edge -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#E6FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
