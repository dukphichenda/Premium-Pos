<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft outer deep-ocean-teal (#0A6E80) refractive glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#260A6E80" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Translucent #0A6E80 tinted water-glass lens body -->
    <item
        android:bottom="1.5dp"
        android:left="1dp"
        android:right="1dp"
        android:top="0.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#4668C4D4"
                android:centerY="0.52"
                android:endColor="#809ADCE8"
                android:startColor="#BAFFFFFF" />
            <stroke
                android:width="1.2dp"
                android:color="#F0FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Upper specular water-droplet highlight arc -->
    <item
        android:bottom="26dp"
        android:left="6dp"
        android:right="6dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#DDFFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- Bottom caustic light bounce -->
    <item
        android:bottom="2.5dp"
        android:left="10dp"
        android:right="10dp"
        android:top="34dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#88FFFFFF"
                android:startColor="#00FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</layer-list>
