<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle dark depth gradient fading up from bottom -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#160F172A"
                android:centerY="0.5"
                android:endColor="#00000000"
                android:startColor="#220F172A" />
        </shape>
    </item>
    <!-- Soft white glow under the floating navigation capsule -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#66FFFFFF"
                android:centerY="0.46"
                android:endColor="#00FFFFFF"
                android:startColor="#DCFFFFFF" />
        </shape>
    </item>
</layer-list>
