<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle dark depth gradient fading down so scrolled items have soft contrast -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#1A0F172A"
                android:centerY="0.55"
                android:endColor="#00000000"
                android:startColor="#240F172A" />
        </shape>
    </item>
    <!-- White translucent top glow behind status bar icons -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#73FFFFFF"
                android:centerY="0.48"
                android:endColor="#00FFFFFF"
                android:startColor="#E0FFFFFF" />
        </shape>
    </item>
</layer-list>
