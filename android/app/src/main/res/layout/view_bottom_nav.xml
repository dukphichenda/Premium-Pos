<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="14dp"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <!-- iOS Liquid Glass Floating Navigation Capsule -->
    <FrameLayout
        android:id="@+id/navCapsulePill"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_nav_capsule"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="12dp">

        <!-- Real-Time Frosted Backdrop Blur Layer -->
        <View
            android:id="@+id/navBlurBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="1.5dp"
            android:clickable="false"
            android:focusable="false" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="5dp">

            <!-- Sliding Liquid Water-Glass Selection Lens -->
            <View
                android:id="@+id/navGlassPill"
                android:layout_width="68dp"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_nav_liquid_glass"
                android:elevation="2dp" />

            <LinearLayout
                android:id="@+id/navTabsRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <!-- 1. Settings -->
            <LinearLayout
                android:id="@+id/navTabSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavSettings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_nav_settings_outline"
                    app:tint="@color/nav_inactive_tint" />

                <TextView
                    android:id="@+id/tvNavSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Settings"
                    android:textColor="@color/nav_inactive_tint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Report -->
            <LinearLayout
                android:id="@+id/navTabReport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavReport"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Report"
                    android:src="@drawable/ic_nav_report_outline"
                    app:tint="@color/nav_inactive_tint" />

                <TextView
                    android:id="@+id/tvNavReport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Report"
                    android:textColor="@color/nav_inactive_tint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Home -->
            <LinearLayout
                android:id="@+id/navTabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavHome"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Home"
                    android:src="@drawable/ic_nav_home_outline"
                    app:tint="@color/nav_inactive_tint" />

                <TextView
                    android:id="@+id/tvNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Home"
                    android:textColor="@color/nav_inactive_tint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 4. SO -->
            <LinearLayout
                android:id="@+id/navTabSo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavSo"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Sales Orders"
                    android:src="@drawable/ic_nav_so_outline"
                    app:tint="@color/nav_inactive_tint" />

                <TextView
                    android:id="@+id/tvNavSo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Sale"
                    android:textColor="@color/nav_inactive_tint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 5. Product -->
            <LinearLayout
                android:id="@+id/navTabProduct"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivNavProduct"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Product"
                    android:src="@drawable/ic_nav_product_outline"
                    app:tint="@color/nav_inactive_tint" />

                <TextView
                    android:id="@+id/tvNavProduct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Product"
                    android:textColor="@color/nav_inactive_tint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
