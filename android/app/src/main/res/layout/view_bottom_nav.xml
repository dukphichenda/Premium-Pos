<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="78dp"
    android:layout_gravity="bottom"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Bottom White Navigation Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Tab 1: Settings -->
            <LinearLayout
                android:id="@+id/navTabSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/ivNavSettings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="@color/gray" />

                <TextView
                    android:id="@+id/tvNavSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Settings"
                    android:textColor="@color/gray"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/indNavSettings"
                    android:layout_width="22dp"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_nav_underline"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Tab 2: Report -->
            <LinearLayout
                android:id="@+id/navTabReport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/ivNavReport"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Report"
                    android:src="@drawable/ic_nav_report"
                    app:tint="@color/gray" />

                <TextView
                    android:id="@+id/tvNavReport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Report"
                    android:textColor="@color/gray"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/indNavReport"
                    android:layout_width="22dp"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_nav_underline"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Tab 3: Home label slot beneath center circle -->
            <LinearLayout
                android:id="@+id/navTabHomeLabel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tvNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="@color/gray"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/indNavHome"
                    android:layout_width="22dp"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_nav_underline"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Tab 4: SO -->
            <LinearLayout
                android:id="@+id/navTabSo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/ivNavSo"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Sales Orders"
                    android:src="@drawable/ic_nav_so"
                    app:tint="@color/gray" />

                <TextView
                    android:id="@+id/tvNavSo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="SO"
                    android:textColor="@color/gray"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/indNavSo"
                    android:layout_width="22dp"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_nav_underline"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Tab 5: Product -->
            <LinearLayout
                android:id="@+id/navTabProduct"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <ImageView
                    android:id="@+id/ivNavProduct"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Product"
                    android:src="@drawable/ic_nav_product"
                    app:tint="@color/gray" />

                <TextView
                    android:id="@+id/tvNavProduct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Product"
                    android:textColor="@color/gray"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/indNavProduct"
                    android:layout_width="22dp"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_nav_underline"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Elevated Center Circular Home Button -->
    <FrameLayout
        android:id="@+id/btnNavHomeCircle"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_nav_home_circle"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:contentDescription="Home"
            android:src="@drawable/ic_nav_home"
            app:tint="@color/white" />
    </FrameLayout>

</FrameLayout>
