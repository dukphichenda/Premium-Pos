<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollCustOrderHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="68dp"
            android:paddingBottom="120dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="16dp">

                <!-- Meta Row: BILINGUAL POS | Page X / Y | Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_slate_controls"
                        android:backgroundTint="#DCFCE7"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="3dp"
                        android:text="BILINGUAL POS"
                        android:textColor="#047857"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCohPageBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_product_thumb"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="3dp"
                        android:text="Page 1 / 1"
                        android:textColor="#475569"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvCohTodayLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nov 27, 2026"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Title & Period -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Customer Order History"
                    android:textColor="#0F172A"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCohPeriodLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="📅 Period: This Month"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <!-- 3 KPI Cards Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Invoices"
                                android:textColor="#64748B"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvCohTotalOrders"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="0 Orders"
                                android:textColor="#0F172A"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Collection"
                                android:textColor="#64748B"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvCohCollectionPct"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="✓ 0% Paid"
                                android:textColor="#059669"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="1dp"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Period Revenue"
                                android:textColor="#64748B"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvCohPeriodRevenue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="$0.00"
                                android:textColor="#0A6C62"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Customer Search Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_floating_top_capsule"
                    android:elevation="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:alpha="0.6"
                        android:src="@android:drawable/ic_menu_search" />

                    <EditText
                        android:id="@+id/etCohSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Search customer name, phone, or SO #..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnCohClearSearch"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnCohPickCustomer"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_pill_slate_controls"
                        android:backgroundTint="#E0F2FE"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="Customer ⌄"
                        android:textColor="#0284C7"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Filter Chips Strip: Status | Paid By | Period | Store -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipCohStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_teal_solid"
                            android:backgroundTint="#0284C7"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="🎛 Status: All"
                            android:textColor="@color/white"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipCohPaidBy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_floating_top_capsule"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Paid By: All ⌄"
                            android:textColor="#334155"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipCohPeriod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_floating_top_capsule"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="📅 This Month"
                            android:textColor="#334155"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipCohBranch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_floating_top_capsule"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="🏪 Main Store"
                            android:textColor="#334155"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Grouped Order History Cards -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCohOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvCohEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="28dp"
                    android:text="No orders found for selected filters"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Export Complete Audit Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_pill_slate_controls"
                            android:backgroundTint="#ECFDF5"
                            android:gravity="center"
                            android:text="📤"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Export Complete Audit"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Open printable &amp; CSV audit export"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCohExport"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#0A6C62"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="↓ Export"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pagination Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnCohPrevPage"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_floating_top_capsule"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="#334155"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCohPageIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_pill_teal_solid"
                        android:backgroundTint="#0A6C62"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="1 / 1"
                        android:textColor="@color/white"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCohNextPage"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_floating_top_capsule"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#334155"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_glow_scrim" />

    <!-- Floating Top Pill Bar -->
    <RelativeLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:paddingHorizontal="14dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnCohBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_floating_top_capsule"
            android:contentDescription="Back"
            android:elevation="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_floating_top_capsule"
            android:elevation="4dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Customer Order History"
            android:textColor="#0F172A"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_floating_top_capsule"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/btnCohRefresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh"
                android:padding="5dp"
                android:src="@drawable/ic_refresh_dark" />
        </LinearLayout>
    </RelativeLayout>

    <View
        android:id="@+id/bottomScrim"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_glow_scrim" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
