<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:id="@+id/scrollTransferDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="68dp"
        android:paddingBottom="190dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Main Transfer Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Scheduled Date Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Scheduled Date"
                            android:textColor="#475569"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnTrfScheduledDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_product_thumb"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="📅 27 - Nov - 2026"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- From Warehouse -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="● From Warehouse (Source / ឃ្លាំងចេញ)"
                        android:textColor="#E11D48"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/btnTrfFromWarehouse"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_floating_top_capsule"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:id="@+id/tvTrfFromWarehouse"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Main Warehouse"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⌄"
                            android:textColor="#64748B"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Swap Arrow -->
                    <TextView
                        android:id="@+id/btnSwapWarehouses"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_pill_slate_controls"
                        android:backgroundTint="#ECFDF5"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="↓"
                        android:textColor="#0A6C62"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- To Warehouse -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="● To Warehouse (Destination / ឃ្លាំងទទួល)"
                        android:textColor="#0A6C62"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/btnTrfToWarehouse"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_floating_top_capsule"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:id="@+id/tvTrfToWarehouse"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="STM Warehouse"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⌄"
                            android:textColor="#64748B"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Transfer Notes -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Transfer Notes &amp; Instructions (កំណត់សំគាល់ / មូលហេតុផ្ទេរ)"
                        android:textColor="#475569"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etTrfNotes"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_product_thumb"
                        android:hint="e.g. Replenishing STM branch"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Transfer Items Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transfer Items"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTrfItemsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_product_thumb"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="0 ITEMS"
                    android:textColor="#475569"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTrfUnitsBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_slate_controls"
                    android:backgroundTint="#E0F2FE"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="0 UNITS"
                    android:textColor="#0284C7"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnTrfClearAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:text="Clear All"
                    android:textColor="#DC2626"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Add Item Controls (hidden when COMPLETED) -->
            <LinearLayout
                android:id="@+id/llTrfAddItemControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btnTrfQuickPick"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_floating_top_capsule"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_pill_slate_controls"
                        android:backgroundTint="#ECFDF5"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#0A6C62"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Type or scan to add product from catalog..."
                        android:textColor="#94A3B8"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnTrfAddFromCatalog"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill_slate_controls"
                    android:backgroundTint="#ECFDF5"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+  Add Item From Catalog"
                    android:textColor="#0A6C62"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Empty Items Box -->
            <LinearLayout
                android:id="@+id/llTrfEmptyLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_product_thumb"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📦"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No items added to this transfer yet"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap Add Item From Catalog above to select products"
                    android:textColor="#64748B"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Line Items Container -->
            <LinearLayout
                android:id="@+id/llTrfLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Telegram-Style Top Status Blur Scrim -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_glow_scrim" />

    <!-- Floating Top Pill Bar -->
    <RelativeLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:paddingHorizontal="14dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnTrfDetBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_floating_top_capsule"
            android:contentDescription="Back"
            android:elevation="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_floating_top_capsule"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STOCK TRANSFER"
                    android:textColor="#0A6C62"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTrfDetHeaderNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRF-00003"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTrfDetStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_slate_controls"
                android:backgroundTint="#FEF3C7"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="✏️ DRAFT"
                android:textColor="#B45309"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_floating_top_capsule"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/btnTrfDetRefresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh"
                android:padding="5dp"
                android:src="@drawable/ic_refresh_dark" />
        </LinearLayout>
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/progressTrfDetail"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:indeterminateTint="#0A6C62"
        android:visibility="gone" />

    <View
        android:id="@+id/bottomScrim"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_glow_scrim" />

    <!-- Bottom Action Bar + Floating Bottom Nav -->
    <LinearLayout
        android:id="@+id/bottomDockGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/llTrfBottomActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_floating_dock_card"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrfCancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="Cancel"
                android:textColor="#475569"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:strokeColor="#CBD5E1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrfSaveDraft"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFBEB"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="💼 Save Draft"
                android:textColor="#B45309"
                android:textSize="11.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="#FDE68A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrfComplete"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.15"
                android:backgroundTint="#0A6C62"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="✓ Complete"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <include
            android:id="@+id/bottomNav"
            layout="@layout/view_bottom_nav" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
