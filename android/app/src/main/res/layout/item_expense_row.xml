<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvExpRowIdx"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_product_thumb"
            android:gravity="center"
            android:text="1"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvExpRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expense Item"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExpRowPayerTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_slate_controls"
                    android:backgroundTint="#FCE7F3"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="1dp"
                    android:text="• Chenda"
                    android:textColor="#BE185D"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvExpRowMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Qty 1 • 01-Nov • Supplier"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvExpRowAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="$0.00"
            android:textColor="#DC2626"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnExpRowEdit"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✎"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnExpRowDelete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🗑"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
