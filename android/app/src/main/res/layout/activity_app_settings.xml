<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:id="@+id/topHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FAFC"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:subtitleTextColor="#0F766E"
                app:title="Settings"
                app:titleTextColor="#0F172A" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scrollSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="104dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Account Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SIGNED IN ACCOUNT"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Admin"
                        android:textColor="@color/black"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Main Store (HQ)"
                        android:textColor="@color/primary_dark"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Store & Sync Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WORKSPACE &amp; SYNC"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingServer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Server: https://premiumpos.cloud"
                        android:textColor="@color/black"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSettingRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Exchange Rate: 4,100 KHR"
                        android:textColor="@color/gray"
                        android:textSize="12.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSettingBranch"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:text="Switch Active Store / Branch" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSettingSync"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:text="Sync Branches, Prices &amp; Delivery Men" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Company Settings Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="6dp"
                        android:text="Company Settings"
                        android:textColor="#0284C7"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/rowCompanyProfile"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="💼  Company Profile"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/rowPricingCurrency"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="💲  Pricing &amp; Currency"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/rowDecimalPrecision"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="🎚  Decimal Precision"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/rowInvoiceCustom"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="🧾  Invoice Customization"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <View android:id="@+id/divUsersPerms" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/rowUsersPerms"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="👥  Users &amp; Permissions"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/rowImportExport"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="⬇  Import &amp; Export Data"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/rowBackupSql"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="💾  Backup &amp; Restore (.sql)"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- System Preferences Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="6dp"
                        android:text="System Preferences"
                        android:textColor="#0284C7"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/rowLocations"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="📍  Locations &amp; Warehouses"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/rowCategories"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="📁  Categories"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/rowImportWizard"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="📥  Import Data Wizard"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/rowExportCenter"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="📤  Export Data Center"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#F1F5F9" />

                    <TextView
                        android:id="@+id/rowSqlMigration"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:text="✉  inFlow SQL Migration"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Portal & App Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenWebPortal"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Open Full Web Portal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenWebSettings"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:text="Open Web System Settings" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckUpdate"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:text="App Version 3.0.0 • Check APK Updates" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSignOut"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/cancel_red"
                        android:text="Sign Out"
                        android:textColor="@color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_glow_scrim" />

    <View
        android:id="@+id/bottomScrim"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_glow_scrim" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
